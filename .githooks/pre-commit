#!/bin/sh
echo "[pre-commit] Running ruff check and format..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

if [ -d "backend" ]; then
    cd backend || exit 1
fi

uvx ruff check . --fix || exit 1
uvx ruff format . || exit 1

if [ -d "../backend" ]; then
    cd ..
fi

echo "$STAGED_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done
