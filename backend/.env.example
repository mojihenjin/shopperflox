# ==============================================================================
# Shopperflox Environment Variables Template (backend/.env.example)
#
# Quick setup:
#   uv run get_env.py -a
# This automatically generates all secure keys, passwords, and mirrors .env to root.
# ==============================================================================

# Application & Environment Mode (dev, test, production)
APP_ENV=dev
DEBUG=True
ENDURO_ATTACK=False
LOG_LEVEL=INFO
LOG_JSON=False

# PostgreSQL Database
POSTGRES_DB=shopperflox
POSTGRES_USER=shopperflox
POSTGRES_PASSWORD=shopperflox_secret
DB_URL=postgresql+asyncpg://shopperflox:shopperflox_secret@localhost:5432/shopperflox

# Redis Cache & Taskiq Message Broker
REDIS_URL=redis://localhost:6379/0

# Security: Argon2id Password Pepper & EdDSA (Ed25519) Asymmetric Keypair
PEPPER=replace_with_32_byte_hex_pepper
JWT_ALGORITHM=EdDSA
JWT_PRIVATE_KEY=replace_with_64_hex_chars_ed25519_seed
JWT_PUBLIC_KEY=replace_with_64_hex_chars_ed25519_public_key
JWT_SECRET_KEY=insecure-secret-key-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
WEBHOOK_SECRET=replace_with_secure_webhook_secret

# Email Dispatch
# "console" = smtpless mode: logs verification codes & reset passwords to worker stdout
# "smtp" = real SMTP server dispatch
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shopper.flox
SMTP_USE_TLS=True

# File Storage ("local" or "s3")
STORAGE_BACKEND=local
MEDIA_LOCAL_DIR=/app/media
MEDIA_BASE_URL=/media

# S3 Object Storage (optional, when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=shopperflox
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ru-1

# Payment Gateway ("stub" for local development / testing)
PAYMENT_BACKEND=stub
BILLING_ENABLED=False
BILLING_URL=

# Prometheus & Grafana Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
